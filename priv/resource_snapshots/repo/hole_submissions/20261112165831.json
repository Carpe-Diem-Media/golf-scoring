        "submitted_by_round_entry_id"
      ],
      "base_filter": null,
      "check": "(\n  (submitted_by_staff_user_id IS NOT NULL)::int +\n  (submitted_by_round_entry_id IS NOT NULL)::int\n) = 1\n",
      "name": "hole_submissions_exactly_one_actor"
    },
    {
      "attribute": [
        "submitted_by_round_entry_id"
      ],
      "base_filter": null,
      "check": "(\n  submitted_by_staff_user_id IS NOT NULL\n  AND submitted_by_round_entry_id IS NULL\n  AND group_role_assignment_id IS NULL\n  AND role_assignment_version IS NULL\n)\nOR (\n  submitted_by_staff_user_id IS NULL\n  AND submitted_by_round_entry_id IS NOT NULL\n  AND group_role_assignment_id IS NOT NULL\n  AND role_assignment_version IS NOT NULL\n  AND role_assignment_version > 0\n)\n",
      "name": "hole_submissions_actor_assignment_shape"
    },
    {
      "attribute": [
        "source"
      ],
      "base_filter": null,
      "check": "source IN ('normal', 'paper_recovery')",
      "name": "hole_submissions_source_allowed"
    },
    {
      "attribute": [
        "recovery_reason"
      ],
      "base_filter": null,
      "check": "(source = 'normal' AND recovery_reason IS NULL)\nOR (\n  source = 'paper_recovery'\n  AND recovery_reason IS NOT NULL\n  AND recovery_reason = btrim(\n    recovery_reason,\n    chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(32) ||\n      chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) ||\n      chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) ||\n      chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) ||\n      chr(8233) || chr(8239) || chr(8287) || chr(12288)\n  )\n  AND char_length(btrim(\n    recovery_reason,\n    chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(32) ||\n      chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) ||\n      chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) ||\n      chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) ||\n      chr(8233) || chr(8239) || chr(8287) || chr(12288)\n  )) > 0\n)\n",
      "name": "hole_submissions_source_reason"
    },
    {
      "attribute": [
        "submitted_by_staff_user_id"
      ],
      "base_filter": null,
      "check": "source <> 'paper_recovery' OR submitted_by_staff_user_id IS NOT NULL",
      "name": "hole_submissions_paper_recovery_staff_only"
    }
  ],
